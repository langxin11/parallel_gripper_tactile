{
    "url": "https://cad.onshape.com/documents/ee6a871f9e00fc227503180b/w/aa505c6adc3fefb88a217362/e/16b75a7cc71174b7cd5960db",
    "output_format": "mujoco",
    "robot_name": "parallel_gripper",
    "output_filename": "parallel_gripper",
    "ignore": {
      "*": "collision",
      "!Pillars*": "collision"
    },

    "joint_properties": {
      "default": {
        "damping": 0.01,
        "frictionloss": 0.0
      },

      "gripper_drive": {
        "actuated": true,
        "type": "position",
        "kp": 20.0,
        "forcerange": 12.5
      },

      "left_link_crank_pin": {
        "actuated": false
      },
      "right_link_crank_pin": {
        "actuated": false
      },
      "left_finger_slide": {
        "actuated": false
      },
      "right_finger_slide": {
        "actuated": false
      }
    },

    "equalities": {
      "closing_left_link_finger_pin": {
        "solref": "0.002 1",
        "solimp": "0.99 0.999 0.0005 0.5 2"
      },
      "closing_right_link_finger_pin": {
        "solref": "0.002 1",
        "solimp": "0.99 0.999 0.0005 0.5 2"
      }
    }
}

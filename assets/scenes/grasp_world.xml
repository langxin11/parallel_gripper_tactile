<mujoco model="robotiq_grasp_world">
  <compiler angle="radian"/>
  <!-- Keep the contact settings used by the Robotiq assets.  MjSpec.attach()
       keeps parent options when they conflict with a child specification. -->
  <option timestep="0.001" gravity="0 0 -9.81" cone="elliptic" impratio="10"/>
  <!-- touch_grid requires a 128 MiB plugin arena.  MuJoCo forbids mixing this
       modern memory setting with the legacy njmax/nconmax size attributes. -->
  <size memory="134217728"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="160" elevation="-20" offwidth="1920" offheight="1080"/>
  </visual>

  <asset>
    <texture name="skybox" type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0"
             width="512" height="3072"/>
    <texture name="groundplane" type="2d" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4"
             rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5"
              reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 3.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" pos="0 0 0" type="plane" material="groundplane"
          friction="0.9 0.02 0.001"/>
    <geom name="target_cube_support_plate" type="box" pos="0 -0.155 0.0625"
          size="0.025 0.025 0.0025" friction="0.9 0.02 0.001"
          solimp="0.90 0.95 0.002" solref="0.015 1" rgba="0.20 0.28 0.36 1"/>
    <camera name="grasp_overview" pos="0.28 -0.35 0.22"
            xyaxes="0.78 0.62 0 -0.30 0.38 0.87"/>
  </worldbody>
</mujoco>
